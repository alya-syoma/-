<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="Світло • Кривий Ріг"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/statusGroup"
                style="@style/Muted" />

            <TextView
                android:id="@+id/statusTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusSubtitle"
                style="@style/Muted" />

            <TextView
                android:id="@+id/statusAddress"
                style="@style/Muted"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/updated"
            style="@style/Muted"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnAddress"
            style="@style/Btn"
            android:layout_marginTop="20dp"
            android:text="Змінити адресу" />

        <Button
            android:id="@+id/btnGroup"
            style="@style/Btn"
            android:text="Обрати чергу вручну" />

        <Button
            android:id="@+id/btnRefresh"
            style="@style/Btn"
            android:text="Оновити" />

        <TextView
            style="@style/Muted"
            android:layout_marginTop="16dp"
            android:text="Черга — з сайту ДТЕК Дніпровські електромережі. Графік — з відкритого репозиторію outage-data-ua (копія даних ДТЕК). Віджет: утримуйте палець на робочому столі → Віджети → «Світло КР»." />
    </LinearLayout>
</ScrollView>
